# Copy to backend/.env. Never commit the populated file.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# CHATAPP-23: HTTP/WS is local development/test only; listener must be a literal
# loopback IP (IPv4 or IPv6). Never publish this port or proxy local mode remotely.
BACKEND_HOST=127.0.0.1
TRANSPORT_MODE=local
# For remote deployment: NODE_ENV=production, TRANSPORT_MODE=proxy,
# CLIENT_URL=https://<frontend-host>. Set exact same-host proxy peer IPs, e.g.
# 127.0.0.1 or ::1 (comma-separated if both are used). No CIDRs/wildcards.
# The proxy must overwrite X-Forwarded-Proto with https and remove Forwarded.
TRUSTED_PROXY_IPS=

# Required for the server. Generate once from >=32 cryptographically random bytes
# (for example, encode 32 random bytes as 64 hex characters); no default is safe.
# Keep private; no whitespace, no repeated-character placeholder. Do not commit.
JWT_SECRET=

# PostgreSQL: native installation or the optional compose.yaml service.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=chatapp_dev
PGUSER=chatapp
# Supply a private, nonempty password locally. There is intentionally no default.
PGPASSWORD=

# disable is allowed only for loopback development/test connections.
# Remote or production connections require verify-full (certificate verification).
DB_SSL_MODE=disable
# Optional path to a trusted PostgreSQL CA certificate, relative to backend/.
DB_SSL_CA_FILE=
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000

# Explicit opt-in; db:seed also requires a local *_dev or *_test database.
DB_ALLOW_SEED=false

# Must be a separate local database ending in _test. Tests never use PGDATABASE.
TEST_PGDATABASE=chatapp_test
