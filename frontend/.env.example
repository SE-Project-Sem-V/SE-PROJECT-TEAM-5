# Copy to .env. While the backend is not ready, keep mock mode on.
VITE_USE_MOCK=true
# Backend address (used when VITE_USE_MOCK=false). Production builds require HTTPS.
# HTTP is allowed only for localhost, 127.0.0.1 or [::1] in development/test.
# For remote deployment, set https://<backend-host> before building Vite.
VITE_API_URL=http://localhost:5000
# Longest message the UI allows. The server enforces the real limit (CHAT-F-013).
VITE_MAX_MESSAGE_LENGTH=1000
